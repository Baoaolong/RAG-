# 二进制文件显式声明，避免 git 试图做换行转换或文本合并
*.bin        binary
*.sqlite3    binary
*.db         binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.zip        binary
*.whl        binary

# 其余按文本处理，并且仓库里统一存 LF
# 这样无论谁在什么系统上提交/拉取，行尾都不会变来变去
* text=auto eol=lf

# 服务器脚本必须是 LF 换行，否则在 Linux 上会报 "\r: command not found"
setup.sh text eol=lf

# 容器与配置同理，保持 LF
Dockerfile text eol=lf
.dockerignore text eol=lf
